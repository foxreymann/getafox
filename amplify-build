version: 0.1
frontend:
  phases:
    preBuild:
      commands:
        - npm ci --prefix app
    # IMPORTANT - Please verify your build commands
    build:
      commands:
        - npm run build --prefix app
  artifacts:
    # IMPORTANT - Please verify your build output directory
    baseDirectory: app/build
    files:
      - '**/*'
  cache:
    paths:
      - app/node_modules/**/*

